generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

// ========================================
// ENUMS
// ========================================

enum Role {
  CUSTOMER
  RESTAURANT_OWNER
  RIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum RestaurantStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TELEBIRR
  MPESA
  ARIFPAY
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  ARRIVED_AT_RESTAURANT
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum VehicleType {
  MOTORCYCLE
  BICYCLE
  CAR
}

enum NotificationType {
  ORDER
  DELIVERY
  PAYMENT
  PROMOTION
  SYSTEM
}

// ========================================
// USER
// ========================================

model User {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  email        String?    @unique
  phone        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  addresses      Address[]
  restaurants    Restaurant[]
  rider          Rider?
  cart           Cart?
  orders         Order[]
  reviews        Review[]
  notifications  Notification[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

// ========================================
// ADDRESS
// ========================================

model Address {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label       String
  address     String
  city        String
  subCity     String?
  phone       String?

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ========================================
// RESTAURANT
// ========================================

model Restaurant {
  id String @id @default(uuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  name        String
  slug        String @unique
  description String?
  phone       String
  email       String?

  logoUrl       String?
  coverImageUrl String?

  address   String
  city      String
  subCity   String?

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  status  RestaurantStatus @default(PENDING)
  isOpen  Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  categories MenuCategory[]
  orders     Order[]
  cart       Cart[]
  reviews    Review[]

  @@index([ownerId])
  @@index([status])
  @@index([city, subCity])
  @@map("restaurants")
}

// ========================================
// MENU CATEGORY
// ========================================

model MenuCategory {
  id String @id @default(uuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

// ========================================
// MENU ITEM
// ========================================

model MenuItem {
  id String @id @default(uuid())

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  description String?

  price Decimal @db.Decimal(10, 2)

  imageUrl String?

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isAvailable])
  @@map("menu_items")
}

// ========================================
// CART
// ========================================

model Cart {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items CartItem[]

  @@index([restaurantId])
  @@map("carts")
}

// ========================================
// CART ITEM
// ========================================

model CartItem {
  id String @id @default(uuid())

  cartId String
  cart   Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, menuItemId])
  @@index([menuItemId])
  @@map("cart_items")
}
// ========================================
// ORDER
// ========================================

model Order {
  id String @id @default(uuid())

  orderNumber String @unique

  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Restrict)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  subtotal     Decimal @db.Decimal(10, 2)
  deliveryFee  Decimal @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)

  status        OrderStatus  @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // Snapshot of delivery information at order time
  deliveryAddress String
  deliveryCity    String
  deliverySubCity String?

  deliveryLatitude  Decimal @db.Decimal(10, 7)
  deliveryLongitude Decimal @db.Decimal(10, 7)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items    OrderItem[]
  payment  Payment?
  delivery Delivery?
  reviews  Review[]

  @@index([customerId])
  @@index([restaurantId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

// ========================================
// ORDER ITEM
// ========================================

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  // Snapshot values at time of purchase
  name  String
  price Decimal @db.Decimal(10, 2)

  quantity Int

  subtotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

// ========================================
// RIDER
// ========================================

model Rider {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleType   VehicleType
  vehicleNumber String?
  licenseNumber String?

  profileImageUrl String?

  isOnline   Boolean @default(false)
  isVerified Boolean @default(false)

  currentLatitude  Decimal? @db.Decimal(10, 7)
  currentLongitude Decimal? @db.Decimal(10, 7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  deliveries Delivery[]
  reviews    Review[]
  
  @@index([isOnline])
  @@index([isVerified])
  @@map("riders")
}

// ========================================
// DELIVERY
// ========================================

model Delivery {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  riderId String?
  rider   Rider? @relation(fields: [riderId], references: [id], onDelete: SetNull)

  status DeliveryStatus @default(PENDING)

  assignedAt             DateTime?
  acceptedAt             DateTime?
  arrivedAtRestaurantAt  DateTime?
  pickedUpAt             DateTime?
  deliveredAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riderId])
  @@index([status])
  @@index([createdAt])
  @@map("deliveries")
}

// ========================================
// PAYMENT
// ========================================

model Payment {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  provider             String?
  transactionReference String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([method])
  @@index([transactionReference])
  @@map("payments")
}

// ========================================
// REVIEW
// ========================================

 model Review {
  id String @id @default(uuid())

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  customerId String
  customer   User @relation(fields: [customerId], references: [id], onDelete: Restrict)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  riderId String?
  rider   Rider? @relation(fields: [riderId], references: [id], onDelete: SetNull)

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([riderId])
  @@index([customerId])
  @@map("reviews")
}
// ========================================
// NOTIFICATION
// ========================================

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String

  type NotificationType

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}